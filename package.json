{
  "name": "rfi-assistant",
  "version": "1.0.0",
  "description": "AI-powered RFI drafting workspace for construction teams",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "npm run start",
    "typecheck": "tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OliviaLong67/OliviaLong.git"
  },
  "keywords": [
    "construction",
    "rfi",
    "ai"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/OliviaLong67/OliviaLong/issues"
  },
  "homepage": "https://github.com/OliviaLong67/OliviaLong#readme",
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.25.0",
    "multer": "^2.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
